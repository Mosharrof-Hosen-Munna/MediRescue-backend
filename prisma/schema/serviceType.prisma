model ServiceType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  isDeleted      Boolean         @default(false)
  deletedAt      DateTime?

  // Relations
  emergencyRequests EmergencyRequest[]

  @@index([isActive])
  @@map("service_types")
}