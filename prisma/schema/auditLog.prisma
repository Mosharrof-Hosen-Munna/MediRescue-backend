model AuditLog {
  id          String      @id @default(uuid())

  userId      String?
  action      AuditAction

  entity      String
  entityId    String?

  oldValue    Json?
  newValue    Json?

  description String?

  ipAddress   String?
  userAgent   String?

  createdAt   DateTime    @default(now())

  user        User?       @relation(fields: [userId],references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}